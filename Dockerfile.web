# syntax=docker/dockerfile:1
#
# CelebrateBanner web (Next.js 15) — production image for Fly.io.
# Runs the real Node server via `next start` (NO Edge conversion; runtime='nodejs'
# route handlers and dynamic routes are preserved).
#
# IMPORTANT: build context is the REPO ROOT — web/ depends on shared/render-engine
# through a `file:` dependency, and render-engine's dist/ is gitignored, so it is
# built fresh from source here (clean-clone safe).
#
#   docker build -f Dockerfile.web -t celebratebanner-web .

FROM node:22-slim AS base

# ── build stage ───────────────────────────────────────────────────────────────
# NODE_ENV is intentionally left UNSET here so `npm ci` installs devDependencies
# (typescript, tailwind, etc.) needed to compile. NODE_ENV=production is set later,
# only for the `next build` step, so no dev value leaks into the production build.
FROM base AS build
WORKDIR /app

# 1) Build the shared render engine from source (dist/ is not committed).
COPY shared/render-engine/package.json shared/render-engine/package-lock.json ./shared/render-engine/
RUN cd shared/render-engine && npm ci
COPY shared/render-engine/ ./shared/render-engine/
RUN cd shared/render-engine && npm run build

# 2) Install web deps (file:../shared/render-engine now resolves). devDeps included.
COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm ci

# 3) Build the Next.js app in PRODUCTION mode. NEXT_PUBLIC_* are non-secret, baked here.
COPY web/ ./web/
ARG NEXT_PUBLIC_SITE_URL=https://app.celebratebanner.com
ARG NEXT_PUBLIC_API_BASE_URL=https://api.celebratebanner.com
ARG NEXT_PUBLIC_LEGACY_STRIPE_LINK=
ENV NODE_ENV=production \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_LEGACY_STRIPE_LINK=$NEXT_PUBLIC_LEGACY_STRIPE_LINK
RUN cd web && npm run build

# ── runtime stage ─────────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production PORT=8080
WORKDIR /app

# Preserve the web ↔ shared relative layout so the file: dependency symlink resolves.
COPY --from=build --chown=node:node /app/shared ./shared
COPY --from=build --chown=node:node /app/web ./web

WORKDIR /app/web
USER node
EXPOSE 8080

# next start honors -p/-H; binds all interfaces on Fly's internal port.
CMD ["npm", "run", "start", "--", "-p", "8080", "-H", "0.0.0.0"]
